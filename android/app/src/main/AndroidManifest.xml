<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- v1.0: 100 % offline. Sin permisos de red ni almacenamiento peligroso:
         los CSV salen por Storage Access Framework (Fase 5) y las fotos de
         favoritos viven en almacenamiento interno de la app. -->
    <application
        android:name=".GuiaApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_app_logo"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.GuiaFarmaceutica">
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.SearchActivity"
            android:exported="false"
            android:theme="@style/Theme.GuiaFarmaceutica" />

        <activity
            android:name=".ui.FichaActivity"
            android:exported="false"
            android:theme="@style/Theme.GuiaFarmaceutica" />

        <activity
            android:name=".ui.CategoryActivity"
            android:exported="false"
            android:theme="@style/Theme.GuiaFarmaceutica" />

        <activity
            android:name=".ui.CalculadoraActivity"
            android:exported="false"
            android:theme="@style/Theme.GuiaFarmaceutica" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.GuiaFarmaceutica" />

        <activity
            android:name=".ui.CrearImpresionActivity"
            android:exported="false"
            android:theme="@style/Theme.GuiaFarmaceutica" />

        <activity
            android:name=".ui.HistorialImpresionesActivity"
            android:exported="false"
            android:theme="@style/Theme.GuiaFarmaceutica" />

        <activity
            android:name=".ui.GestionClinicaActivity"
            android:exported="false"
            android:theme="@style/Theme.GuiaFarmaceutica" />

        <activity
            android:name=".ui.PerfilPacienteActivity"
            android:exported="false"
            android:theme="@style/Theme.GuiaFarmaceutica" />

        <activity
            android:name=".ui.CrearIndicacionActivity"
            android:exported="false"
            android:theme="@style/Theme.GuiaFarmaceutica" />

        <activity
            android:name=".ui.HistorialClinicoActivity"
            android:exported="false"
            android:theme="@style/Theme.GuiaFarmaceutica" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
