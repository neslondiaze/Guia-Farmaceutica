<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0F4C81"
        app:elevation="4dp"
        app:liftOnScroll="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="12dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Atrás"
                android:src="@drawable/ic_back_arrow" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_indicacion_header_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PLAN DE CUIDADOS FICTICIO"
                    android:textColor="#E0E0E0"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_indicacion_header_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Indicaciones médicas"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="60dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card Indicaciones No Farmacológicas -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="ACTIVIDAD O REPOSO">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edit_indicacion_actividad"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Texto demostrativo de reposo activo o relativo" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="ALIMENTACIÓN">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edit_indicacion_alimentacion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Texto demostrativo de plan alimentario" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="HIDRATACIÓN">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edit_indicacion_hidratacion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Texto demostrativo de ingesta de líquidos" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="CUIDADOS">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edit_indicacion_cuidados"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Texto demostrativo de cuidados en casa" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="ESTUDIOS SOLICITADOS">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edit_indicacion_estudios"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Estudio ficticio (ej. Laboratorio / Rx)" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="SEÑALES DE ALARMA">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edit_indicacion_alarma"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Texto demostrativo, sin orientación clínica real" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:hint="FECHA DE SEGUIMIENTO">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edit_indicacion_fecha_seg"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="dd / mm / aaaa" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:hint="NOTAS ADICIONALES">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edit_indicacion_notas"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Notas ficticias" />
                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_guardar_borrador_indicacion"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:text="Guardar borrador" />

                        <Button
                            android:id="@+id/btn_vista_previa_indicacion"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:text="Ver vista previa" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Banner Aviso de Prototipo -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#0F2D4A"
                app:cardCornerRadius="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_cat_security"
                        app:tint="#60A5FA" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Prototipo de demostración: usa información ficticia y conserva cambios solo durante esta sesión. Una implementación real debe cumplir las normas aplicables de privacidad, seguridad, trazabilidad y regulación sanitaria."
                        android:textColor="@android:color/white"
                        android:textSize="11sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
